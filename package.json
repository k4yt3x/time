{
  "name": "time",
  "version": "0.1.0",
  "private": true,
  "description": "The exact time in any time zone, city or UTC offset",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k4yt3x/time.git"
  },
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "node scripts/serve.ts",
    "typecheck": "tsc",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test",
    "tzdb": "node scripts/tzdb.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@preact/signals": "^2.11.4",
    "preact": "^11.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
